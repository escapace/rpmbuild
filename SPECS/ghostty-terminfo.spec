Name:           ghostty-terminfo
Version:        1.4.0
Release:        1%{?dist}
URL:            https://github.com/ghostty-org/ghostty
Summary:        The terminfo file for ghostty Terminal
License:        MIT
BuildArch:      noarch

# Generated by scripts/ghostty-terminfo from src/terminfo/ghostty.zig
Source0:        ghostty.terminfo
Source1:        LICENSE

BuildRequires:  ncurses
Requires:       ncurses-base

%description
Terminal emulator that uses platform-native UI and GPU acceleration.

The terminfo file for ghostty Terminal.

%prep
cp -p %{SOURCE1} .

%build
mkdir terminfo
tic -x -o terminfo %{SOURCE0}

%install
install -d %{buildroot}%{_datadir}/terminfo/x %{buildroot}%{_datadir}/terminfo/g
install -m 0644 terminfo/x/xterm-ghostty %{buildroot}%{_datadir}/terminfo/x/xterm-ghostty
install -m 0644 terminfo/g/ghostty %{buildroot}%{_datadir}/terminfo/g/ghostty

%files
%license LICENSE
%{_datadir}/terminfo/x/xterm-ghostty
%{_datadir}/terminfo/g/ghostty
