class ManageError(Exception):
    """Raised when a manage command cannot complete."""


@dataclasses.dataclass(frozen=True)
class RpmPackage:
    name: str
    epoch: str
    version: str
    release: str
    arch: str
    sourcerpm: str
    path: Path

    @property
    def evr(self) -> str:
        return format_evr(self.epoch, self.version, self.release)


@dataclasses.dataclass(frozen=True)
class RepositoryPackage:
    name: str
    epoch: str
    version: str
    release: str
    arch: str
    repo: str

    @property
    def evr(self) -> str:
        return format_evr(self.epoch, self.version, self.release)


@dataclasses.dataclass(frozen=True)
class OutdatedPackage:
    local: RpmPackage
    available: RepositoryPackage
    comparison: int

    @property
    def status(self) -> str:
        return "same" if self.comparison == 0 else "newer"


def info(message: str) -> None:
    print(message, flush=True)


def warn(message: str) -> None:
    print("warning: {0}".format(message), file=sys.stderr, flush=True)


def fatal(message: str) -> ManageError:
    return ManageError(message)


def repository_dir() -> Path:
    return Path(__file__).resolve().parent


def command_name(command: Sequence[str]) -> str:
    return shlex.join(command)


def print_command(command: Sequence[str]) -> None:
    info("$ {0}".format(command_name(command)))


def command_path(name: str) -> Optional[str]:
    found = shutil.which(name)
    if found is not None:
        return found
    for directory in ("/usr/sbin", "/usr/bin", "/sbin", "/bin"):
        candidate = Path(directory) / name
        if candidate.is_file() and os.access(str(candidate), os.X_OK):
            return str(candidate)
    return None


def require_command(name: str) -> str:
    path = command_path(name)
    if path is None:
        raise fatal("missing required command: {0}".format(name))
    return path


def run_command(
    command: Sequence[str],
    cwd: Optional[Path] = None,
    env: Optional[Mapping[str, str]] = None,
    input_text: Optional[str] = None,
    capture: bool = False,
) -> subprocess.CompletedProcess[str]:
    print_command(command)
    try:
        completed = subprocess.run(
            list(command),
            cwd=str(cwd) if cwd else None,
            env=dict(env) if env is not None else None,
            input=input_text,
            stdout=subprocess.PIPE if capture else None,
            stderr=subprocess.PIPE if capture else None,
            text=True,
            check=False,
        )
    except OSError as exc:
        raise fatal("unable to run {0}: {1}".format(command[0], exc))

    if completed.returncode != 0:
        if capture:
            if completed.stdout:
                print(
                    completed.stdout,
                    end="" if completed.stdout.endswith("\n") else "\n",
                )
            if completed.stderr:
                print(
                    completed.stderr,
                    end="" if completed.stderr.endswith("\n") else "\n",
                    file=sys.stderr,
                )
        raise fatal(
            "command failed with exit code {0}: {1}".format(
                completed.returncode, command_name(command)
            )
        )
    return completed


def run_command_ok(
    command: Sequence[str],
    cwd: Optional[Path] = None,
    env: Optional[Mapping[str, str]] = None,
    stdout: Optional[int] = None,
    stderr: Optional[int] = None,
) -> bool:
    print_command(command)
    try:
        completed = subprocess.run(
            list(command),
            cwd=str(cwd) if cwd else None,
            env=dict(env) if env is not None else None,
            stdout=stdout,
            stderr=stderr,
            text=True,
            check=False,
        )
    except OSError as exc:
        warn("unable to run {0}: {1}".format(command[0], exc))
        return False
    return completed.returncode == 0


def run_output(command: Sequence[str], cwd: Optional[Path] = None) -> str:
    return run_command(command, cwd=cwd, capture=True).stdout.strip()


def quiet_output(
    command: Sequence[str], env: Optional[Mapping[str, str]] = None
) -> str:
    try:
        completed = subprocess.run(
            list(command),
            env=dict(env) if env is not None else None,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
    except OSError as exc:
        raise fatal("unable to run {0}: {1}".format(command[0], exc))
    if completed.returncode != 0:
        stderr = completed.stderr.strip()
        detail = ": {0}".format(stderr) if stderr else ""
        raise fatal(
            "command failed with exit code {0}: {1}{2}".format(
                completed.returncode, command_name(command), detail
            )
        )
    return completed.stdout


def quiet_completed(
    command: Sequence[str], env: Optional[Mapping[str, str]] = None
) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            list(command),
            env=dict(env) if env is not None else None,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
    except OSError as exc:
        raise fatal("unable to run {0}: {1}".format(command[0], exc))


def format_evr(epoch: str, version: str, release: str) -> str:
    normalized_epoch = epoch or "0"
    return "{0}:{1}-{2}".format(normalized_epoch, version, release)


def parse_os_release() -> Dict[str, str]:
    for path in (Path("/etc/os-release"), Path("/usr/lib/os-release")):
        if not path.is_file():
            continue
        data: Dict[str, str] = {}
        for raw_line in path.read_text(encoding="utf-8").splitlines():
            line = raw_line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            data[key] = value.strip().strip("'\"")
        return data
    return {}


def require_centos_10() -> None:
    data = parse_os_release()
    if data.get("ID") == "centos" and data.get("VERSION_ID", "").startswith("10"):
        return
    if "el10" in data.get("PLATFORM_ID", ""):
        return
    raise fatal("outdated is supported only on CentOS Stream 10")


def rpm_arch_from_platform() -> str:
    machine = platform_module.machine().lower()
    if machine in ("x86_64", "amd64"):
        return "x86_64"
    if machine in ("aarch64", "arm64"):
        return "aarch64"
    raise fatal("unsupported architecture: {0}".format(platform_module.machine()))


def selected_outdated_arches(value: str) -> List[str]:
    if value == "current":
        return [rpm_arch_from_platform()]
    if value == "all":
        return ["x86_64", "aarch64"]
    return [value]


def rpm_query_file(path: Path) -> RpmPackage:
    text = quiet_output(["rpm", "-qp", "--qf", RPM_QUERY_FORMAT, str(path)])
    parts = text.rstrip("\n").split("\t")
    if len(parts) != 6:
        raise fatal("unexpected rpm query output for {0}: {1!r}".format(path, text))
    name, epoch, version, release, arch, sourcerpm = parts
    return RpmPackage(
        name=name,
        epoch=epoch or "0",
        version=version,
        release=release,
        arch=arch,
        sourcerpm=sourcerpm,
        path=path,
    )


def local_rpm_packages(rpm_dir: Path, arches: Sequence[str]) -> List[RpmPackage]:
    if not rpm_dir.is_dir():
        raise fatal("RPM directory not found: {0}".format(rpm_dir))
    compatible_arches = set(arches) | {"noarch"}
    packages = []
    for path in sorted(rpm_dir.glob("*.rpm")):
        package = rpm_query_file(path)
        if package.arch in compatible_arches:
            packages.append(package)
    return packages


def repoquery_base_command() -> List[str]:
    repoquery = command_path("repoquery")
    if repoquery is not None:
        return [repoquery, "--quiet"]
    dnf = command_path("dnf")
    if dnf is not None:
        return [dnf, "--quiet", "repoquery"]
    dnf5 = command_path("dnf5")
    if dnf5 is not None:
        return [dnf5, "--quiet", "repoquery"]
    raise fatal("missing required command: repoquery or dnf")


def enabled_repository_ids() -> List[str]:
    dnf = command_path("dnf") or command_path("dnf5")
    if dnf is None:
        return []
    completed = quiet_completed([dnf, "--quiet", "repolist", "--enabled"])
    if completed.returncode != 0:
        stderr = completed.stderr.strip()
        detail = ": {0}".format(stderr) if stderr else ""
        raise fatal("unable to list enabled repositories{0}".format(detail))
    repositories = []
    for line in completed.stdout.splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("repo id"):
            continue
        repositories.append(stripped.split()[0])
    return repositories


def selected_repositories(explicit: Sequence[str]) -> List[str]:
    if explicit:
        return list(dict.fromkeys(explicit))
    enabled = set(enabled_repository_ids())
    return [repo for repo in OUTDATED_DEFAULT_REPOSITORIES if repo in enabled]


def chunks(values: Sequence[str], size: int) -> Sequence[Sequence[str]]:
    return [values[index : index + size] for index in range(0, len(values), size)]


def repoquery_command(
    names: Sequence[str], arch: str, repositories: Sequence[str], refresh: bool
) -> List[str]:
    command = repoquery_base_command()
    if refresh:
        command.append("--refresh")
    if repositories:
        command.append("--disablerepo=*")
        for repository in repositories:
            command.append("--enablerepo={0}".format(repository))
    command.extend(
        [
            "--forcearch={0}".format(arch),
            "--available",
            "--latest-limit=1",
            "--arch",
            "{0},noarch".format(arch),
            "--queryformat",
            REPOQUERY_FORMAT,
            *names,
        ]
    )
    return command


def parse_repoquery_output(text: str) -> List[RepositoryPackage]:
    packages = []
    for line in text.splitlines():
        if not line.strip():
            continue
        parts = line.split("\t")
        if len(parts) != 6:
            raise fatal("unexpected repoquery output line: {0!r}".format(line))
        name, epoch, version, release, package_arch, repo = parts
        packages.append(
            RepositoryPackage(
                name=name,
                epoch=epoch or "0",
                version=version,
                release=release,
                arch=package_arch,
                repo=repo,
            )
        )
    return packages


def repoquery_packages(
    names: Sequence[str], arch: str, repositories: Sequence[str], refresh: bool
) -> List[RepositoryPackage]:
    packages = []
    for name_chunk in chunks(names, REPOQUERY_NAME_CHUNK_SIZE):
        command = repoquery_command(name_chunk, arch, repositories, refresh)
        packages.extend(parse_repoquery_output(quiet_output(command)))
    return packages


def compare_rpm_versions(left: str, right: str) -> int:
    if left == right:
        return 0
    if not left:
        return -1
    if not right:
        return 1
    env = os.environ.copy()
    env["RPMCMP_A"] = left
    env["RPMCMP_B"] = right
    text = quiet_output(["rpm", "--eval", RPM_COMPARE_EXPRESSION], env=env).strip()
    try:
        value = int(text)
    except ValueError as exc:
        raise fatal("unexpected rpm comparison output: {0!r}".format(text)) from exc
    if value < 0:
        return -1
    if value > 0:
        return 1
    return 0


def compare_evr(
    left_epoch: str,
    left_version: str,
    left_release: str,
    right_epoch: str,
    right_version: str,
    right_release: str,
) -> int:
    left_epoch_int = int(left_epoch or "0")
    right_epoch_int = int(right_epoch or "0")
    if left_epoch_int < right_epoch_int:
        return -1
    if left_epoch_int > right_epoch_int:
        return 1
    version_compare = compare_rpm_versions(left_version, right_version)
    if version_compare:
        return version_compare
    return compare_rpm_versions(left_release, right_release)


def best_repository_package(packages: Sequence[RepositoryPackage]) -> RepositoryPackage:
    best = packages[0]
    for package in packages[1:]:
        if (
            compare_evr(
                package.epoch,
                package.version,
                package.release,
                best.epoch,
                best.version,
                best.release,
            )
            > 0
        ):
            best = package
    return best


def raise_keyboard_interrupt(signum: int, frame: object) -> None:
    raise KeyboardInterrupt("received signal {0}".format(signum))


def install_signal_handlers() -> None:
    for name in ("SIGTERM", "SIGHUP"):
        signum = getattr(signal, name, None)
        if signum is not None:
            signal.signal(signum, raise_keyboard_interrupt)


def truth(value: Optional[str]) -> bool:
    if value is None:
        return False
    return value.strip().lower() in ("1", "yes", "y", "true", "t", "on")


def in_container() -> bool:
    return truth(os.environ.get(CONTAINER_ENVIRONMENT_VARIABLE))


def require_container(command: str) -> None:
    if not in_container():
        raise fatal("{0} must run inside a manage container".format(command))
    if not CONTAINER_REPOSITORY.is_dir():
        raise fatal("{0} mount is missing".format(CONTAINER_REPOSITORY))
    if command == "container-update-repository":
        if repository_dir() != CONTAINER_REPOSITORY:
            raise fatal(
                "{0} must run from mounted repository {1}".format(
                    command, CONTAINER_REPOSITORY
                )
            )
        return
    expected_repository = Path("/home/centos/rpmbuild")
    if repository_dir() != expected_repository:
        raise fatal(
            "{0} must run from {1} inside the rpmbuild container".format(
                command, expected_repository
            )
        )
    if not Path("/etc/mock/site-defaults.cfg").is_file():
        raise fatal("mock site defaults are missing; not running in the rpmbuild image")


def current_platform() -> str:
    machine = platform_module.machine().lower()
    if machine in ("x86_64", "amd64"):
        return "linux/amd64"
    if machine in ("aarch64", "arm64"):
        return "linux/arm64"
    raise fatal("unsupported architecture: {0}".format(platform_module.machine()))


def mock_configuration_for_platform(platform: str) -> str:
    configuration = MOCK_CONFIGURATIONS.get(platform)
    if configuration is None:
        raise fatal("unsupported platform: {0}".format(platform))
    return configuration


def image_name(explicit: Optional[str]) -> str:
    if explicit:
        return explicit
    configured = os.environ.get("RPMBUILD_IMAGE")
    if configured:
        return configured
    scope = os.environ.get("DOCKER_SCOPE", DEFAULT_IMAGE_SCOPE).rstrip("/")
    return "{0}/rpmbuild".format(scope)


def maybe_relabel_for_container(repository: Path) -> None:
    selinuxenabled = command_path("selinuxenabled")
    sudo = command_path("sudo")
    if selinuxenabled is None or sudo is None:
        return
    probe = subprocess.run(
        [selinuxenabled],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if probe.returncode != 0:
        return
    run_command([sudo, "chcon", "-Rt", "svirt_sandbox_file_t", str(repository)])


def docker_environment() -> Dict[str, str]:
    env = os.environ.copy()
    if hasattr(os, "getuid"):
        env["HOST_UID"] = str(os.getuid())
    if hasattr(os, "getgid"):
        env["HOST_GID"] = str(os.getgid())
    return env


def docker_run_command(
    image: str,
    platform: Optional[str],
    repository: Path,
    inner_command: Sequence[str],
) -> List[str]:
    command = ["docker", "run"]
    if platform:
        command.extend(["--platform", platform])
    command.extend(
        [
            "--rm",
            "--privileged",
            "-v",
            "{0}:{1}".format(repository, CONTAINER_REPOSITORY),
            "-e",
            "HOST_UID",
            "-e",
            "HOST_GID",
            "-e",
            "CONTAINER=true",
            image,
            *inner_command,
        ]
    )
    return command


def host_build(args: argparse.Namespace) -> int:
    require_command("docker")
    repository = repository_dir()
    platform = args.platform or current_platform()
    configuration = args.configuration or mock_configuration_for_platform(platform)
    selected_image = image_name(args.image)
    maybe_relabel_for_container(repository)

    ok = True
    for name in args.name:
        if (
            find_rpm_resource(
                name, repository / "SPECS", repository / "SOURCES", repository / "SRPMS"
            )
            is None
        ):
            warn("unable to find RPM resources for {0}".format(name))
            ok = False
            continue
        info("processing {0} on {1}".format(name, platform))
        command = docker_run_command(
            selected_image,
            platform,
            repository,
            ["container-build", "--configuration", configuration, name],
        )
        try:
            run_command(command, env=docker_environment())
        except ManageError as exc:
            warn(str(exc))
            ok = False
    return 0 if ok else 1


def find_rpm_resource(
    name: str, specs: Path, sources: Path, srpms: Path
) -> Optional[Path]:
    spec = specs / "{0}.spec".format(name)
    if spec.is_file() and (sources / name).is_dir():
        return spec

    pattern = re.compile(r"^{0}(-.*)?\.src\.rpm$".format(re.escape(name)))
    if srpms.is_dir():
        for path in sorted(srpms.glob("*.src.rpm")):
            if pattern.match(path.name):
                return path
    return None


def clean_container_workdir(workdir: Path) -> None:
    for name in ("BUILD", "RPMS", "SPECS", "SRPMS", "SOURCES"):
        path = workdir / name
        if path.exists() or path.is_symlink():
            if path.is_dir() and not path.is_symlink():
                shutil.rmtree(path)
            else:
                path.unlink()
    for name in ("BUILD", "RPMS", "SPECS", "SRPMS"):
        (workdir / name).mkdir(parents=True, exist_ok=True)


def host_arch() -> str:
    machine = platform_module.machine()
    if machine in ("x86_64", "amd64"):
        return "x86_64"
    if machine in ("aarch64", "arm64"):
        return "aarch64"
    return machine


def package_install_arguments(name: str, arch: str) -> List[str]:
    arguments: List[str] = []
    for template in PACKAGE_INSTALL_REQUIREMENTS.get(name, ()):
        value = template.format(arch=arch)
        if not value.startswith("http"):
            value = str(CONTAINER_REPOSITORY / value)
        arguments.extend(["--install", value])
    return arguments


def run_mock(configuration: str, args: Sequence[str]) -> None:
    run_command([*MOCK_BASE_COMMAND, "-r", configuration, *args])


def run_sudo(command: Sequence[str]) -> None:
    if hasattr(os, "geteuid") and os.geteuid() == 0:
        run_command(command)
        return
    sudo = require_command("sudo")
    run_command([sudo, *command])


def chown_for_current_user(path: Path) -> None:
    run_sudo(["chown", "-R", "{0}:{1}".format(os.getuid(), os.getgid()), str(path)])


def chown_for_host(path: Path) -> None:
    host_uid = os.environ.get("HOST_UID")
    host_gid = os.environ.get("HOST_GID")
    if host_uid and host_gid:
        run_sudo(["chown", "-R", "{0}:{1}".format(host_uid, host_gid), str(path)])


def ensure_mount_directory(path: Path) -> None:
    run_sudo(["install", "-d", "-m", "0775", str(path)])


def sudo_copy_file(source: Path, destination: Path) -> None:
    ensure_mount_directory(destination.parent)
    run_sudo(["cp", "-f", str(source), str(destination)])


def copy_build_results(workdir: Path) -> None:
    output_rpms = CONTAINER_REPOSITORY / "RPMS"
    output_srpms = CONTAINER_REPOSITORY / "SRPMS"
    ensure_mount_directory(output_rpms)
    ensure_mount_directory(output_srpms)

    for rpm in sorted((workdir / "RPMS").rglob("*.rpm")):
        if rpm.name.endswith(".src.rpm"):
            continue
        sudo_copy_file(rpm, output_rpms / rpm.name)
    for srpm in sorted((workdir / "SRPMS").rglob("*.src.rpm")):
        sudo_copy_file(srpm, output_srpms / srpm.name)

    chown_for_host(output_rpms)
    chown_for_host(output_srpms)


def container_build(args: argparse.Namespace) -> int:
    require_container("container-build")
    name = args.name
    configuration = args.configuration
    workdir = repository_dir()
    source_resource = find_rpm_resource(
        name,
        CONTAINER_REPOSITORY / "SPECS",
        CONTAINER_REPOSITORY / "SOURCES",
        CONTAINER_REPOSITORY / "SRPMS",
    )
    if source_resource is None:
        raise fatal("unable to find RPM resources for {0}".format(name))

    clean_container_workdir(workdir)
    sources = workdir / "SOURCES"
    specs = workdir / "SPECS"
    srpms = workdir / "SRPMS"

    if source_resource.suffix == ".spec":
        shutil.copytree(CONTAINER_REPOSITORY / "SOURCES" / name, sources)
        shutil.copy2(source_resource, specs / source_resource.name)
    else:
        shutil.copy2(source_resource, srpms / source_resource.name)

    info("starting mock with {0} configuration".format(configuration))
    run_mock(configuration, ["--dnf", "--init"])

    install_arguments = package_install_arguments(name, host_arch())
    if install_arguments:
        run_mock(
            configuration, ["--no-clean", "--no-cleanup-after", *install_arguments]
        )

    if source_resource.suffix == ".spec":
        info("building SRPM for {0}".format(name))
        run_mock(
            configuration,
            [
                "--no-clean",
                "--no-cleanup-after",
                "--buildsrpm",
                "--spec={0}".format(specs / source_resource.name),
                "--sources={0}".format(sources),
                "--resultdir={0}".format(srpms),
            ],
        )

    srpm_files = sorted(str(path) for path in srpms.rglob("*.src.rpm"))
    if not srpm_files:
        raise fatal("no source RPM was produced for {0}".format(name))

    info("building RPMs for {0}".format(name))
    run_mock(
        configuration,
        [
            "--no-clean",
            "--no-cleanup-after",
            "--rebuild",
            *srpm_files,
            "--resultdir={0}".format(workdir / "RPMS"),
        ],
    )
    copy_build_results(workdir)
    return 0


def rpm_arch(path: Path) -> str:
    return quiet_output(
        ["rpm", "--nosignature", "-q", "--qf", "%{arch}", str(path)]
    ).strip()


def createrepo_command() -> str:
    path = command_path("createrepo_c") or command_path("createrepo")
    if path is None:
        raise fatal("missing required command: createrepo_c or createrepo")
    return path


def container_update_repository(args: argparse.Namespace) -> int:
    require_container("container-update-repository")
    require_command("rpm")
    createrepo = createrepo_command()

    mounted_repository = CONTAINER_REPOSITORY / "repository"
    ensure_mount_directory(mounted_repository)
    chown_for_current_user(mounted_repository)

    repository_root = (
        mounted_repository / args.environment / "linux" / "centos" / args.releasever
    )
    architectures: Dict[str, Path] = {
        "x86_64": repository_root / "x86_64",
        "aarch64": repository_root / "aarch64",
    }
    for directory in architectures.values():
        if directory.exists():
            shutil.rmtree(directory)
        directory.mkdir(parents=True, exist_ok=True)

    rpm_files = sorted((CONTAINER_REPOSITORY / "RPMS").glob("*.rpm"))
    rpm_arches = {rpm_file: rpm_arch(rpm_file) for rpm_file in rpm_files}
    for rpm_file, arch in rpm_arches.items():
        if arch == "noarch":
            continue
        target = repository_root / arch
        architectures[arch] = target
        target.mkdir(parents=True, exist_ok=True)
        shutil.copy2(rpm_file, target / rpm_file.name)

    for rpm_file, arch in rpm_arches.items():
        if arch != "noarch":
            continue
        for target in architectures.values():
            target.mkdir(parents=True, exist_ok=True)
            shutil.copy2(rpm_file, target / rpm_file.name)

    for arch, target in sorted(architectures.items()):
        repomd = target / "repodata" / "repomd.xml"
        action = "updating" if repomd.exists() else "creating"
        info("{0} {1} repository".format(action, arch))
        command = [createrepo]
        if repomd.exists():
            command.append("--update")
        command.append(str(target))
        run_command(command)

    chown_for_host(mounted_repository)
    return 0


def ensure_update_repository_image(image: str) -> None:
    require_command("docker")
    run_command(
        ["docker", "build", "--tag", image, "-"],
        input_text=UPDATE_REPOSITORY_DOCKERFILE,
    )


def docker_run_mounted_manage_command(
    image: str,
    platform: Optional[str],
    repository: Path,
    manage_arguments: Sequence[str],
) -> List[str]:
    command = ["docker", "run"]
    if platform:
        command.extend(["--platform", platform])
    command.extend(
        [
            "--rm",
            "--privileged",
            "-v",
            "{0}:{1}".format(repository, CONTAINER_REPOSITORY),
            "-e",
            "HOST_UID",
            "-e",
            "HOST_GID",
            "-e",
            "CONTAINER=true",
            "--entrypoint",
            "/usr/bin/python3",
            image,
            str(CONTAINER_REPOSITORY / "manage"),
            *manage_arguments,
        ]
    )
    return command


def host_update_repository(args: argparse.Namespace) -> int:
    require_command("docker")
    repository = repository_dir()
    selected_image = args.image or UPDATE_REPOSITORY_IMAGE
    if args.image is None:
        ensure_update_repository_image(selected_image)
    platform = args.platform
    command = docker_run_mounted_manage_command(
        selected_image,
        platform,
        repository,
        [
            "container-update-repository",
            "--releasever",
            args.releasever,
            "--environment",
            args.environment,
        ],
    )
    run_command(command, env=docker_environment())
    return 0


def trust_key(key_id: str) -> bool:
    gpg = require_command("gpg")
    for keyserver in GPG_KEYSERVERS:
        for attempt in range(2):
            if attempt:
                time.sleep(1)
            if run_command_ok(
                [gpg, "--keyserver", keyserver, "--recv-keys", key_id],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            ):
                run_command(
                    [gpg, "--import-ownertrust"],
                    input_text="{0}:5:\n".format(key_id),
                    capture=True,
                )
                return True
    return False


def trust_escapace(args: argparse.Namespace) -> int:
    if not trust_key(ESCAPACE_GPG_KEY_ID):
        raise fatal("failed to import Escapace public key")
    info("Escapace public key has been added to the local GPG keyring")
    return 0


def check(args: argparse.Namespace) -> int:
    uv = require_command("uv")
    repository = repository_dir()
    commands = []

    ruff_format = [uv, *UV_RUN_CHECK, "ruff", "format"]
    if not args.fix:
        ruff_format.append("--check")
    ruff_format.append("manage")
    commands.append(ruff_format)

    ruff_check = [uv, *UV_RUN_CHECK, "ruff", "check"]
    if args.fix:
        ruff_check.append("--fix")
    ruff_check.append("manage")
    commands.append(ruff_check)
    commands.append([uv, *UV_RUN_CHECK, "ty", "check", "manage"])

    ok = True
    for command in commands:
        try:
            run_command(command, cwd=repository)
        except ManageError as exc:
            warn(str(exc))
            ok = False
    return 0 if ok else 1


def outdated(args: argparse.Namespace) -> int:
    require_centos_10()
    require_command("rpm")
    arches = selected_outdated_arches(args.arch)
    repositories = selected_repositories(args.repo)
    if not args.repo and not repositories:
        raise fatal(
            "none of the default repositories are enabled; pass --repo explicitly"
        )

    rpm_dir = repository_dir() / "RPMS"
    local_packages = local_rpm_packages(rpm_dir, arches)
    names = sorted({package.name for package in local_packages})

    available: Dict[str, List[RepositoryPackage]] = {}
    for arch in arches:
        for package in repoquery_packages(names, arch, repositories, args.refresh):
            available.setdefault(package.name, []).append(package)

    results = []
    for local in local_packages:
        compatible_arches = (
            {"noarch"} if local.arch == "noarch" else {local.arch, "noarch"}
        )
        candidates = [
            package
            for package in available.get(local.name, [])
            if package.arch in compatible_arches
        ]
        if not candidates:
            continue
        best = best_repository_package(candidates)
        comparison = compare_evr(
            local.epoch,
            local.version,
            local.release,
            best.epoch,
            best.version,
            best.release,
        )
        if comparison <= 0:
            results.append(
                OutdatedPackage(local=local, available=best, comparison=comparison)
            )

    if args.json:
        print(
            json.dumps(
                [
                    {
                        "name": result.local.name,
                        "arch": result.local.arch,
                        "local_evr": result.local.evr,
                        "available_evr": result.available.evr,
                        "available_arch": result.available.arch,
                        "status": result.status,
                        "repo": result.available.repo,
                        "file": str(result.local.path.relative_to(repository_dir())),
                        "sourcerpm": result.local.sourcerpm,
                    }
                    for result in results
                ],
                indent=2,
                sort_keys=True,
            )
        )
        return 0

    if results:
        print(
            "name\tarch\tlocal_evr\tavailable_evr\tavailable_arch\tstatus\trepo\tfile"
        )
    for result in results:
        print(
            "{0}\t{1}\t{2}\t{3}\t{4}\t{5}\t{6}\t{7}".format(
                result.local.name,
                result.local.arch,
                result.local.evr,
                result.available.evr,
                result.available.arch,
                result.status,
                result.available.repo,
                result.local.path.relative_to(repository_dir()),
            )
        )
    return 0


def add_host_commands(subparsers: argparse._SubParsersAction) -> None:
    build_parser = subparsers.add_parser(
        "build",
        help="build packages by running the rpmbuild container from the host",
    )
    build_parser.add_argument("name", nargs="+", help="RPM package name(s) to build")
    build_parser.add_argument(
        "--platform",
        choices=tuple(MOCK_CONFIGURATIONS),
        help="container platform; defaults to the current machine architecture",
    )
    build_parser.add_argument(
        "--configuration",
        help="mock configuration; defaults from --platform",
    )
    build_parser.add_argument(
        "--image",
        help="container image; defaults to RPMBUILD_IMAGE or DOCKER_SCOPE/rpmbuild",
    )
    build_parser.set_defaults(func=host_build)

    update_parser = subparsers.add_parser(
        "update-repository",
        help="update repository metadata by running the rpmbuild container from the host",
    )
    update_parser.add_argument(
        "--platform",
        choices=tuple(MOCK_CONFIGURATIONS),
        help="optional platform for the repository update container",
    )
    update_parser.add_argument(
        "--image",
        help="container image; defaults to an inline CentOS Stream 10 createrepo image",
    )
    update_parser.add_argument("--releasever", default=DEFAULT_RELEASEVER)
    update_parser.add_argument("--environment", default=DEFAULT_REPOSITORY_ENVIRONMENT)
    update_parser.set_defaults(func=host_update_repository)

    outdated_parser = subparsers.add_parser(
        "outdated",
        help="list RPMS/ packages also available at the same or newer version",
    )
    outdated_parser.add_argument(
        "--arch",
        choices=("current", "x86_64", "aarch64", "all"),
        default="current",
        help="RPM architecture to check; defaults to current architecture plus noarch",
    )
    outdated_parser.add_argument(
        "--repo",
        action="append",
        default=[],
        help="repository id to query; can be repeated",
    )
    outdated_parser.add_argument(
        "--refresh",
        action="store_true",
        help="refresh repository metadata before querying",
    )
    outdated_parser.add_argument(
        "--json",
        action="store_true",
        help="emit JSON instead of tab-separated text",
    )
    outdated_parser.set_defaults(func=outdated)

    check_parser = subparsers.add_parser(
        "check",
        help="run development checks with uv-managed tools",
    )
    check_parser.add_argument(
        "--fix",
        action="store_true",
        help="format and apply safe fixes before non-mutating checks",
    )
    check_parser.set_defaults(func=check)


def add_container_commands(subparsers: argparse._SubParsersAction) -> None:
    container_build_parser = subparsers.add_parser(
        "container-build",
        help="build one package inside the rpmbuild container",
    )
    container_build_parser.add_argument("name", help="RPM package name to build")
    container_build_parser.add_argument(
        "--configuration",
        required=True,
        help="mock configuration to use inside the container",
    )
    container_build_parser.set_defaults(func=container_build)

    container_update_parser = subparsers.add_parser(
        "container-update-repository",
        help="update repository metadata inside the rpmbuild container",
    )
    container_update_parser.add_argument("--releasever", default=DEFAULT_RELEASEVER)
    container_update_parser.add_argument(
        "--environment", default=DEFAULT_REPOSITORY_ENVIRONMENT
    )
    container_update_parser.set_defaults(func=container_update_repository)

    trust_parser = subparsers.add_parser(
        "trust-escapace",
        help="import and owner-trust the Escapace public GPG key",
    )
    trust_parser.set_defaults(func=trust_escapace)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="manage")
    subparsers = parser.add_subparsers(dest="command", title="commands")
    if in_container():
        add_container_commands(subparsers)
    else:
        add_host_commands(subparsers)
    return parser


def main(argv: Optional[Sequence[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if not hasattr(args, "func"):
        parser.print_help()
        return 0
    try:
        install_signal_handlers()
        return args.func(args)
    except KeyboardInterrupt as exc:
        print("interrupted: {0}".format(exc), file=sys.stderr)
        return 130
    except ManageError as exc:
        print("error: {0}".format(exc), file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
