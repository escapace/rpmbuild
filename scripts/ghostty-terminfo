#!/usr/bin/python3
"""Render ghostty's terminfo definition (src/terminfo/ghostty.zig) as tic source.

Mirrors Source.encode() upstream, so the output compiles to the same entry
that `zig build` installs, without needing zig.

    scripts/ghostty-terminfo 1.4.0 > SOURCES/ghostty-terminfo/ghostty.terminfo
"""
import re
import sys
from urllib import request

URL = "https://raw.githubusercontent.com/ghostty-org/ghostty/v{0}/src/terminfo/ghostty.zig"
ZIG_STRING = r'"((?:[^"\\]|\\.)*)"'
CAPABILITY = re.compile(
    r"\.name = " + ZIG_STRING + r", \.value = \.\{ \.(\w+)(?: = (.*?))? \}"
)


def unescape(value: str) -> str:
    return re.sub(r"\\(.)", r"\1", value)


def render(source: str) -> list:
    names = re.search(r"\.names = &\.\{(.*?)\n    \},", source, re.S).group(1)
    names = re.sub(r"//[^\n]*", "", names)
    lines = ["|".join(unescape(n) for n in re.findall(ZIG_STRING, names)) + ","]
    for line in source.splitlines():
        if line.lstrip().startswith("//"):
            continue
        match = CAPABILITY.search(line)
        if match is None:
            continue
        name, kind, value = unescape(match.group(1)), match.group(2), match.group(3)
        if kind == "boolean":
            lines.append("\t{0},".format(name))
        elif kind == "canceled":
            lines.append("\t{0}@,".format(name))
        elif kind == "numeric":
            lines.append("\t{0}#{1},".format(name, int(value)))
        elif kind == "string":
            value = unescape(re.fullmatch(ZIG_STRING, value).group(1))
            lines.append("\t{0}={1},".format(name, value))
        else:
            sys.exit("unknown capability kind: {0}".format(kind))
    return lines


def main() -> None:
    if len(sys.argv) != 2:
        sys.exit("usage: ghostty-terminfo <version>")
    version = sys.argv[1]
    with request.urlopen(URL.format(version)) as response:
        source = response.read().decode()
    print("# Generated by scripts/ghostty-terminfo from ghostty v{0}".format(version))
    print("# src/terminfo/ghostty.zig")
    print("\n".join(render(source)))


if __name__ == "__main__":
    main()
